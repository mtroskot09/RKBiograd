# Copy to .env for local development (.env is git-ignored). In production set these in the
# hosting dashboard (Render: render.yaml asks for them).

# Postgres. Leave empty locally to keep data in memory (lost on restart).
DATABASE_URL=postgres://postgres:dev@localhost:5433/postgres

# Admin login with Google. Leave GOOGLE_CLIENT_ID empty locally: login is then disabled
# and you are automatically the local admin (never allowed in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed into the admin panel, comma-separated.
ADMIN_EMAILS=
# Random string that signs the login cookie.
SESSION_SECRET=
# Public address of the site; the Google redirect URI is <PUBLIC_URL>/api/callback.
# On Render this defaults to the onrender.com address.
PUBLIC_URL=
