# Copy to .env for local development (.env is git-ignored), then run `php artisan key:generate`.
# In production set these in the hosting dashboard (Render: render.yaml asks for them).

APP_NAME="RK Biograd"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database. Locally SQLite is easiest (database/database.sqlite, created by `php artisan migrate`).
# On Render DB_URL is the Postgres connection string (set automatically by render.yaml).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_URL=postgres://postgres:dev@localhost:5433/postgres

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single

# Admin login with Google. Leave GOOGLE_CLIENT_ID empty locally: login is then disabled
# and you are automatically the local admin (never allowed in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed into the admin panel, comma-separated.
ADMIN_EMAILS=
# Public address of the site; the Google redirect URI is <PUBLIC_URL>/api/callback.
# On Render this defaults to the onrender.com address.
PUBLIC_URL=

# E-mail (contact form and club e-mails). "log" writes e-mails to storage/logs/laravel.log
# instead of sending them – handy locally. In production use smtp (e.g. Gmail, Brevo, Mailgun).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="info@rkbiograd.hr"
MAIL_FROM_NAME="RK Biograd"
# Where contact form messages go. Empty = the e-mail from Admin → Kontakt podaci.
CONTACT_RECIPIENT=
